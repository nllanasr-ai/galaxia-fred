#Triangulo de asteriscos 
n = 5
for i in range (1, n + 1):
    print("*" * i)

#triangulo de asteriscos invertido
n = 5
for i in range(n, 0, -1):
    print("*" * i)
    
    #piramide de centrada de asteriscos
    for i in range(1, n + 1):
        espacios = " " * (n - i)
        asteriscos = "*" * (2 * i - 1)
        print(espacios + asteriscos) 
        #piramide de centrada de asteriscos invertida
    for i in range(n, 0, -1):
        espacios = " " * (n - i)
        asteriscos = "*" * (2 * i - 1)
        print(espacios + asteriscos) 
        